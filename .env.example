# Signal Pop Environment Configuration
# Copy this file to .env and fill in your values.

# --- Date Configuration ---
# Prep date in YYYYMMDD format (defaults to yesterday)
# SIGNAL_POP_PREP_DATE=20260717

# --- API Keys ---
# SenseNova API key for image generation
SENSENOVA_API_KEY=your_sensenova_api_key_here

# Unsplash API key (optional, for cover images)
UNSPLASH_API_KEY=your_unsplash_api_key_here

# --- Paths ---
# Output base directory (defaults to ./output)
# SIGNAL_POP_OUTPUT_BASE=E:/projects/signal_pop/output

# Script file path (defaults to archive/signal_pop_daily_<DATE>.txt)
# SIGNAL_POP_SCRIPT_FILE=E:/projects/signal_pop/archive/signal_pop_weekly_special_20260717.txt

# --- FFmpeg ---
# Path to ffmpeg executable (defaults to 'ffmpeg' in PATH)
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFMPEG_PATH=C:/ffmpeg/bin/ffmpeg.exe

# --- Fonts ---
# Font paths for video text rendering
# SIGNAL_POP_FONT_REGULAR=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
# SIGNAL_POP_FONT_BOLD=/usr/share/fonts/opentype/noto/NotoSansCJK-Bold.ttc
# On Windows:
# SIGNAL_POP_FONT_REGULAR=C:/Windows/Fonts/msyh.ttc
# SIGNAL_POP_FONT_BOLD=C:/Windows/Fonts/msyhbd.ttc

# --- Logging ---
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# SIGNAL_POP_LOG_LEVEL=INFO

# --- Distribution ---
# HER2HOME_VIDEO_PATH=/path/to/her2home/video.mp4
# HER2HOME_COVER_PATH=/path/to/her2home/cover.png
