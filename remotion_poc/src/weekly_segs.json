 },
 {
  "speaker": "阿信",
  "voice": "zh_male_m191_uranus_bigtts",
  "text": "接着聊科技。英伟达129.3亿美元收购Hugging Face。英伟达9月3日宣布以129.3亿美元收购全球最大AI开源社区Hugging Face，黄仁勋回应称\"不是为了把AI关进英伟达\"，开源生态整合引发全球开发者热议。",
  "dur": 18.972125,
  "bg": "news_02.jpg",
  "video": "",
  "videoDur": 0,
  "isBreaking": false,
  "isInteractive": false,
  "cta": false,
  "data": [],
  "agenda": []
 },
 {
  "speaker": "小蓝",
  "voice": "zh_female_shuangkuaisisi_uranus_bigtts",
  "text": "129亿美元买下一个开源社区，黄仁勋这手笔吓人，还好他承诺不把AI关进围墙。",
  "dur": 7.632458333333333,
  "bg": "news_02.jpg",
  "video": "",
  "videoDur": 0,
  "isBreaking": false,
  "isInteractive": false,
  "cta": false,
  "data": [],
  "agenda": []
 },
 {
  "speaker": "阿信",
  "voice": "zh_male_m191_uranus_bigtts",
  "text": "开源生态是AI世界的公共地基，收购之后保持开放还是走向封闭，全球开发者都盯着。",
  "dur": 8.743958333333333,
  "bg": "news_02.jpg",
  "video": "",
  "videoDur": 0,
  "isBreaking": false,
  "isInteractive": false,
  "cta": false,
  "data": [],
  "agenda": []
 },
 {
  "speaker": "阿信",
  "voice": "zh_male_m191_uranus_bigtts",
  "text": "接着聊经济。字节跳动被曝获296亿美元银团贷款。字节跳动已获得296亿美元贷款（约合人民币超2100亿元），成为2026年亚洲规模第二大的美元计价贷款，或加码AI与全球化业务。",
  "dur": 17.967,
  "bg": "news_03.jpg",
  "video": "",
  "videoDur": 0,
  "isBreaking": false,
  "isInteractive": false,
  "cta": false,
  "data": [],
  "agenda": []
 },
 {
  "speaker": "小蓝",
  "voice": "zh_female_shuangkuaisisi_uranus_bigtts",
  "text": "296亿美元贷款，字节这是要憋大招啊，就不知道这钱最后砸向哪个赛道。",
  "dur": 6.827333333333334,
  "bg": "news_03.jpg",
  "video": "",
  "videoDur": 0,
  "isBreaking": false,
  "isInteractive": false,
  "cta": false,
  "data": [],
  "agenda": []
 },
 {
  "speaker": "阿信",
  "voice": "zh_male_m191_uranus_bigtts",
  "text": "亚洲第二大美元贷款，说明机构对字节的现金流有信心，AI和全球化大概率是去向。",
  "dur": 7.020083333333333,
  "bg": "news_03.jpg",
  "video": "",
  "videoDur": 0,
  "isBreaking": false,
  "isInteractive": false,
  "cta": false,
  "data": [],
  "agenda": []
 },
 {
  "speaker": "阿信",
  "voice": "zh_male_m191_uranus_bigtts",
  "text": "接着聊科技。世界首例猪肾助肾衰竭患者摆脱透析9个月。《柳叶刀》刊载美国麻总百瀚医疗系统最新病例报告，基因编辑猪肾在患者体内正常工作9个月、帮助其摆脱透析，最终成功等到人体供肾，为异种移植里程碑。",
  "dur": 20.613291666666665,
  "bg": "news_04.jpg",
  "video": "",
  "videoDur": 0,
  "isBreaking": false,
  "isInteractive": false,
  "cta": false,
  "data": [],
  "agenda": []
 },
 {
  "speaker": "小蓝",
  "voice": "zh_female_shuangkuaisisi_uranus_bigtts",
  "text": "猪肾扛了9个月还等到人体供肾，医学这一步走得太不容易了，为研究团队点赞。",
  "dur": 5.178625,
  "bg": "news_04.jpg",
  "video": "",
  "videoDur": 0,
  "isBreaking": false,
  "isInteractive": false,
  "cta": false,
  "data": [],
  "agenda": []
 },
 {
  "speaker": "阿信",
  "voice": "zh_male_m191_uranus_bigtts",
  "text": "异种移植从实验走向临床案例，器官等待名单上的希望又多了一分，意义在里程碑级。",
  "dur": 7.280666666666667,
  "bg": "news_04.jpg",
  "video": "",
  "videoDur": 0,
  "isBreaking": false,
  "isInteractive": false,
  "cta": false,
  "data": [],
  "agenda": []
 },
 {
  "speaker": "阿信",
  "voice": "zh_male_m191_uranus_bigtts",
  "text": "接着聊民生。微信回应\"好友超1万可查看单删好友\"。微信公关总监回应\"好友超1万可查看单删\"话题冲上热搜；微信还灰度测试\"防错过\"新功能，长按左下角图标可查看全部未读消息，红包转账右上角主动提醒。",
  "dur": 18.256625,
  "bg": "news_05.jpg",
  "video": "",
  "videoDur": 0,
  "isBreaking": false,
  "isInteractive": false,
  "cta": false,
  "data": [],
  "agenda": []
 },
 {
  "speaker": "小蓝",
  "voice": "zh_female_shuangkuaisisi_uranus_bigtts",
  "text": "好友超一万才能看单删，这是大佬的烦恼，咱们普通人只求别被静悄悄删掉。",
  "dur": 6.165583333333333,
  "bg": "news_05.jpg",
  "video": "",
  "videoDur": 0,
  "isBreaking": false,
  "isInteractive": false,
  "cta": false,
  "data": [],
  "agenda": []
 },
 {
  "speaker": "阿信",
  "voice": "zh_male_m191_uranus_bigtts",
  "text": "功能向少数重度用户倾斜可以理解，但‘防错过’这种全量优化才是真普惠。",
  "dur": 7.6317916666666665,
  "bg": "news_05.jpg",
  "video": "",
  "videoDur": 0,
  "isBreaking": false,
  "isInteractive": false,
  "cta": false,
