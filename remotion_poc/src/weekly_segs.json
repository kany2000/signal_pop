  "agenda": []
 },
 {
  "speaker": "小蓝",
  "voice": "zh_female_shuangkuaisisi_uranus_bigtts",
  "text": "厄尔尼诺又来了，还可能变超强，看来秋天的衣服得多备几件厚实的。",
