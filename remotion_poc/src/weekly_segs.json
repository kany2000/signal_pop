 },
 {
  "speaker": "阿信",
  "voice": "zh_male_m191_uranus_bigtts",
  "text": "调配8000件、4810件已到，救援效率看得见，后续安置和灾后重建还得持续盯。",
  "dur": 8.245083333333334,
  "bg": "news_01.jpg",
  "video": "",
  "videoDur": 0,
