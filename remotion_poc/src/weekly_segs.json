  "bg": "news_06.jpg",
  "video": "",
  "videoDur": 0,
  "isBreaking": false,
  "isInteractive": false,
  "cta": false,
  "data": [],
  "agenda": []
 },
 {
  "speaker": "阿信",
  "voice": "zh_male_m191_uranus_bigtts",
  "text": "在微观尺度验证爱因斯坦的等效原理，量子引力实验往前挪了一小步，基础物理一大步。",
  "dur": 7.449,
